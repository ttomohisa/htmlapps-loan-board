{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Loan Board",
  "nameJa": "貸出・返却ボード",
  "slug": "loan-board",
  "version": "1.0.1",
  "description": "Manage equipment checkout, returns, outstanding items, history, autosave, backups, and CSV exports locally on one device.",
  "descriptionJa": "備品の貸出・返却、未返却、履歴、自動保存、バックアップ、CSV出力を1台の端末内で管理する貸出・返却ボードです。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-loan-board"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
