{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Loan Board",
  "nameJa": "貸出・返却ボード",
  "slug": "loan-board",
  "version": "0.1.0",
  "description": "Track equipment and borrowers locally in the browser, with a foundation for fast checkout and return workflows.",
  "descriptionJa": "備品と貸出先をブラウザー内で管理し、素早い貸出・返却フローへつなげるための基礎を提供します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-loan-board"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
