{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Loan Board",
  "nameJa": "貸出・返却ボード",
  "slug": "loan-board",
  "version": "0.2.0",
  "description": "Track equipment checkout locally in the browser, including borrower selection, multi-item checkout, and double-checkout prevention.",
  "descriptionJa": "貸出先を選び、複数備品をまとめて貸し出し、二重貸出を防止するブラウザー内完結の貸出ボードです。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-loan-board"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
